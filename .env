# Canonical public URL of the deployed site, with a trailing slash.
# Used for canonical/og:url/og:image, JSON-LD, the sitemap and robots.txt.
# Override per deploy: VITE_SITE_URL=https://example.com/ npm run build
VITE_SITE_URL=https://saidmadi.com/

# Path the site is served from. "/" for a custom domain or org site,
# "/<repo>/" for a GitHub Pages project site.
BASE_PATH=/
