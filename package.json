{
  "name": "said-madi-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:locales && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:locales": "node scripts/check-locales.mjs",
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "typecheck": "tsc -b --force",
    "audit": "npm audit --omit=dev",
    "licenses": "npx --yes license-checker-rseidelsohn --production --summary"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "framer-motion": "^13.4.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.15",
    "stylis": "^4.4.0",
    "stylis-plugin-rtl": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/stylis": "^4.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "description": "Portfolio for Said Madi — software engineer, AI platforms. Bilingual EN/AR with RTL.",
  "license": "MIT"
}
